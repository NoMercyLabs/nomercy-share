<Project Sdk="Microsoft.NET.Sdk">
  <!-- The proof run: renders the bar headless (Skia, no window on screen) to PNG and checks that its position is remembered. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same fakes the unit tests use, so the proof run has one set of stand-ins. -->
    <Compile Include="../../tests/NoMercy.Share.Core.Tests/Fakes.cs" Link="Fakes.cs" />
    <Compile Include="../../tests/NoMercy.Share.Core.Tests/FakeAreaPicking.cs" Link="FakeAreaPicking.cs" />
    <ProjectReference Include="../../src/NoMercy.Share.App/NoMercy.Share.App.csproj" />
  </ItemGroup>
</Project>
