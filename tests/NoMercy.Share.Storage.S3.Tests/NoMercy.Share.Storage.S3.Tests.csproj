<Project Sdk="Microsoft.NET.Sdk">
  <!-- Uploads through the real uploader to S3Mock in Docker. Each test skips itself when Docker is not available. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NoMercy.Share.Storage.S3/NoMercy.Share.Storage.S3.csproj" />
  </ItemGroup>
</Project>
