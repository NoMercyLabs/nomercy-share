<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Windows capture for real on the desktop of the machine; each test skips itself where there is no interactive desktop. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NAudio.WinMM" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NoMercy.Share.Platform.Windows/NoMercy.Share.Platform.Windows.csproj" />
    <!-- Only so the app is built before the live focus test starts it. -->
    <ProjectReference Include="../../src/NoMercy.Share.App/NoMercy.Share.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
