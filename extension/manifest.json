{
  "manifest_version": 3,
  "name": "NoMercy Share",
  "version": "0.1.0",
  "description": "Capture the open tab and share it as a link through the NoMercy Share app.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "debugger", "clipboardWrite", "contextMenus"],
  "action": {
    "default_title": "NoMercy Share",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
