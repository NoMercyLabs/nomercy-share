<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NoMercy.Share.App" xmlns:icons="using:NoMercy.Share.App.Icons"
        xmlns:settings="using:NoMercy.Share.Core.Settings"
        x:Class="NoMercy.Share.App.SettingsWindow" x:DataType="settings:SettingsViewModel" Classes="settings"
        Title="{local:Loc settings.title}" WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        CanResize="False" Width="768" Height="720" WindowStartupLocation="CenterScreen">
  <!-- The bar's own surface, ring and shadow; the margin holds the shadow, as on the bar. No OS frame: the brand row drags, the cross and Escape cancel. -->
  <Border x:Name="Surface" Classes="surface">
  <Panel>
  <DockPanel>
    <!-- Fixed under the content: Cancel and Save are bar pills, the accent only on focus; a failure that belongs to no field shows here, so scrolling never hides it. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Share-Separator-Brush}" BorderThickness="0,1,0,0"
            Padding="{DynamicResource Nm-Space-3-Thickness}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Nm-Space-4}">
        <!-- The bar's cross only hides the bar, so ending the app lives here. -->
        <Button x:Name="QuitButton" Classes="footer" Content="{local:Loc settings.quit}" Command="{Binding QuitCommand}" />
        <TextBlock Grid.Column="1" Classes="save-error" Text="{Binding SaveError}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-2}">
          <Button Classes="footer" Content="{local:Loc settings.cancel}" Click="OnCancelClick" IsCancel="True" />
          <Button Classes="footer primary" Content="{local:Loc settings.save}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="200,*">
      <Border BorderBrush="{DynamicResource Share-Separator-Brush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="{DynamicResource Nm-Space-3-Thickness}" Spacing="{DynamicResource Nm-Space-3}">
          <Border x:Name="Handle" Classes="brand" Background="Transparent" Cursor="SizeAll" Padding="12,0"
                  ToolTip.Tip="{local:Loc bar.drag}" AutomationProperties.Name="{local:Loc bar.drag}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
              <local:NoMercyMark Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Classes="brand-name" Text="{local:Loc app.name}" />
            </StackPanel>
          </Border>
          <ListBox Classes="rail" SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}" AutomationProperties.Name="{local:Loc settings.sections}">
            <ListBoxItem AutomationProperties.Name="{local:Loc settings.section.general}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
                <icons:MoooomIcon Kind="settings" />
                <TextBlock Text="{local:Loc settings.section.general}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="{local:Loc settings.section.sharing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
                <icons:MoooomIcon Kind="cloudUpload" />
                <TextBlock Text="{local:Loc settings.section.sharing}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="{local:Loc settings.section.hotkeys}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
                <icons:MoooomIcon Kind="keyboard" />
                <TextBlock Text="{local:Loc settings.section.hotkeys}" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="{local:Loc settings.section.recording}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
                <icons:MoooomIcon Kind="webcam" />
                <TextBlock Text="{local:Loc settings.section.recording}" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="Page" Grid.Column="1">
        <!-- 12 above and below, as the rail has: the page title shares the top row with the brand and the cross. -->
        <Grid Margin="24,12">

          <StackPanel Spacing="{DynamicResource Nm-Space-4}" IsVisible="{Binding ShowsGeneral}">
            <TextBlock Classes="section" Text="{local:Loc settings.section.general}" />
            <Border Classes="group">
              <StackPanel>
                <Grid Classes="switch-row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="switch-label" Text="{local:Loc settings.general.showbar}" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowBarInCaptures}" OnContent="" OffContent="" MinWidth="0"
                                AutomationProperties.Name="{local:Loc settings.general.showbar}" />
                </Grid>
                <TextBlock Classes="status note-text" Text="{local:Loc settings.general.showbar.helper}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel Classes="field">
                <TextBlock Classes="field-label" Text="{local:Loc settings.expiry}" />
                <ComboBox ItemsSource="{Binding ExpiryChoices}" SelectedItem="{Binding SelectedExpiry}" IsVisible="{Binding ShowsStorageFields}"
                          AutomationProperties.Name="{local:Loc settings.expiry}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="settings:ExpiryChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="status note-text" Text="{local:Loc settings.expiry.discord}" TextWrapping="Wrap" IsVisible="{Binding IsDiscord}" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <Grid Classes="switch-row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="switch-label" Text="{local:Loc settings.recording.systemsound}" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordSystemSound}" OnContent="" OffContent="" MinWidth="0"
                                AutomationProperties.Name="{local:Loc settings.recording.systemsound}" />
                </Grid>
                <Grid Classes="switch-row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="switch-label" Text="{local:Loc settings.recording.microphone}" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordMicrophone}" OnContent="" OffContent="" MinWidth="0"
                                AutomationProperties.Name="{local:Loc settings.recording.microphone}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="group">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Nm-Space-2}">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.resolution}" />
                  <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}" AutomationProperties.Name="{local:Loc settings.recording.resolution}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="settings:ResolutionChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="field-error" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.size}" />
                  <TextBox Text="{Binding MaxSizeMegabytes}" AutomationProperties.Name="{local:Loc settings.recording.size}">
                    <TextBox.InnerRightContent>
                      <TextBlock Classes="unit" Text="{local:Loc settings.unit.mb}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <TextBlock Classes="field-error" Text="{Binding MaxSizeError}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Spacing="{DynamicResource Nm-Space-4}" IsVisible="{Binding ShowsSharing}">
            <TextBlock Classes="section" Text="{local:Loc settings.section.sharing}" />
            <StackPanel Classes="note">
              <icons:MoooomIcon Kind="infoCircle" />
              <TextBlock Classes="status" Text="{Binding SharingStatus}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ListBox Classes="segmented" ItemsSource="{Binding Providers}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Provider}"
                     AutomationProperties.Name="{local:Loc settings.provider}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="settings:ProviderChoice">
                  <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Classes="group" IsVisible="{Binding ShowsStorageFields}">
              <StackPanel Spacing="{DynamicResource Nm-Space-2}">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.endpoint}" />
                  <TextBox PasswordChar="•" Text="{Binding Endpoint}" AutomationProperties.Name="{local:Loc settings.endpoint}">
                    <TextBox.InnerRightContent>
                      <Button Classes="bar small" Click="OnRevealClick" ToolTip.Tip="{local:Loc settings.reveal}" AutomationProperties.Name="{local:Loc settings.reveal}">
                        <icons:MoooomIcon Kind="eye" />
                      </Button>
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <TextBlock Classes="field-error" Text="{Binding EndpointError}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Nm-Space-2}">
                  <StackPanel Classes="field">
                    <TextBlock Classes="field-label" Text="{local:Loc settings.bucket}" />
                    <TextBox Text="{Binding Bucket}" AutomationProperties.Name="{local:Loc settings.bucket}" />
                    <TextBlock Classes="field-error" Text="{Binding BucketError}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Classes="field">
                    <TextBlock Classes="field-label" Text="{local:Loc settings.region}" />
                    <TextBox Text="{Binding Region}" AutomationProperties.Name="{local:Loc settings.region}" />
                    <TextBlock Classes="field-error" Text="{Binding RegionError}" />
                  </StackPanel>
                </Grid>
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.publicbase}" />
                  <TextBox Text="{Binding PublicBaseUrl}" AutomationProperties.Name="{local:Loc settings.publicbase}" />
                  <TextBlock Classes="field-error" Text="{Binding PublicBaseUrlError}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="group" IsVisible="{Binding ShowsStorageFields}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Nm-Space-2}">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.keyid}" />
                  <TextBox PasswordChar="•" Text="{Binding AccessKeyId}" AutomationProperties.Name="{local:Loc settings.keyid}">
                    <TextBox.InnerRightContent>
                      <Button Classes="bar small" Click="OnRevealClick" ToolTip.Tip="{local:Loc settings.reveal}" AutomationProperties.Name="{local:Loc settings.reveal}">
                        <icons:MoooomIcon Kind="eye" />
                      </Button>
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <TextBlock Classes="field-error" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.secret}" />
                  <TextBox PasswordChar="•" Text="{Binding SecretAccessKey}" PlaceholderText="{Binding SecretPlaceholder}" AutomationProperties.Name="{local:Loc settings.secret}">
                    <TextBox.InnerRightContent>
                      <Button Classes="bar small" Click="OnRevealClick" ToolTip.Tip="{local:Loc settings.reveal}" AutomationProperties.Name="{local:Loc settings.reveal}">
                        <icons:MoooomIcon Kind="eye" />
                      </Button>
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <TextBlock Classes="field-error" Text="{Binding CredentialError}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="group" IsVisible="{Binding IsDiscord}">
              <StackPanel Classes="field">
                <TextBlock Classes="field-label" Text="{local:Loc settings.discord.webhook}" />
                <TextBox PasswordChar="•" Text="{Binding DiscordWebhook}" PlaceholderText="{Binding DiscordWebhookPlaceholder}"
                         AutomationProperties.Name="{local:Loc settings.discord.webhook}" />
                <TextBlock Classes="field-error" Text="{Binding DiscordWebhookError}" />
                <TextBlock Classes="status note-text" Text="{local:Loc settings.discord.helper}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="{DynamicResource Nm-Space-4}" IsVisible="{Binding ShowsHotkeys}">
            <TextBlock Classes="section" Text="{local:Loc settings.section.hotkeys}" />
            <Border Classes="group">
              <ItemsControl ItemsSource="{Binding Hotkeys}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{DynamicResource Nm-Space-2}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:HotkeyRow">
                    <StackPanel Classes="field">
                      <TextBlock Classes="field-label" Text="{Binding Label}" />
                      <TextBox Classes="chord" IsReadOnly="True" Text="{Binding Chord}" PlaceholderText="{local:Loc settings.hotkey.off}" KeyDown="OnChordKeyDown" GotFocus="OnChordGotFocus" LostFocus="OnChordLostFocus"
                               AutomationProperties.Name="{Binding Label}">
                        <TextBox.InnerLeftContent>
                          <Panel IsHitTestVisible="False">
                            <ItemsControl Classes="keycaps" ItemsSource="{Binding Chord, Converter={x:Static local:ChordCapsConverter.Instance}}" IsVisible="{Binding !IsListening}" Focusable="False">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-1}" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="keycap">
                                    <TextBlock Text="{Binding}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="listening" Text="{local:Loc settings.hotkey.listening}" IsVisible="{Binding IsListening}" />
                          </Panel>
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                          <Button Classes="bar small" Click="OnClearClick" ToolTip.Tip="{local:Loc settings.hotkey.clear}"
                                  AutomationProperties.Name="{local:Loc settings.hotkey.clear}">
                            <icons:MoooomIcon Kind="cross" />
                          </Button>
                        </TextBox.InnerRightContent>
                      </TextBox>
                      <TextBlock Classes="field-error" Text="{Binding Error}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <StackPanel Spacing="{DynamicResource Nm-Space-4}" IsVisible="{Binding ShowsRecording}">
            <TextBlock Classes="section" Text="{local:Loc settings.section.recording}" />
            <Border Classes="group">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Nm-Space-2}">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.fps}" />
                  <TextBox Text="{Binding FrameRate}" AutomationProperties.Name="{local:Loc settings.recording.fps}">
                    <TextBox.InnerRightContent>
                      <TextBlock Classes="unit" Text="{local:Loc settings.unit.fps}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <TextBlock Classes="field-error" Text="{Binding FrameRateError}" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- The encode of the shared file: the same pill choice as the provider. Only encoders that passed a test encode on this PC are listed. -->
            <Border Classes="group">
              <StackPanel Spacing="{DynamicResource Nm-Space-4}">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.codec}" />
                  <ListBox Classes="segmented" ItemsSource="{Binding CodecChoices}" SelectedItem="{Binding SelectedCodec}" AutomationProperties.Name="{local:Loc settings.recording.codec}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="settings:OptionChoice">
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="status note-text" Text="{local:Loc settings.recording.codec.helper}" />
                </StackPanel>
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.encoder}" />
                  <ListBox Classes="segmented" ItemsSource="{Binding EncoderChoices}" SelectedItem="{Binding SelectedEncoder}" AutomationProperties.Name="{local:Loc settings.recording.encoder}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="settings:OptionChoice">
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="status note-text" Text="{Binding EncoderNote}" IsVisible="{Binding EncoderNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label" Text="{local:Loc settings.recording.speed}" />
                  <ListBox Classes="segmented" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding SelectedSpeed}" AutomationProperties.Name="{local:Loc settings.recording.speed}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="settings:OptionChoice">
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
  <Button Classes="bar close" Click="OnCancelClick" ToolTip.Tip="{local:Loc bar.close}" AutomationProperties.Name="{local:Loc bar.close}">
    <icons:MoooomIcon Kind="cross" />
  </Button>
  </Panel>
  </Border>
</Window>
