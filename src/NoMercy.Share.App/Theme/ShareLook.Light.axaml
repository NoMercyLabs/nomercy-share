<!-- NoMercy Share's look on top of the NM tokens (light). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Share-Bar-Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Share-Ring-Brush" Color="#1F000000" />
  <SolidColorBrush x:Key="Share-Hover-Brush" Color="#14000000" />
  <SolidColorBrush x:Key="Share-Separator-Brush" Color="#1F000000" />
  <BoxShadows x:Key="Share-Shadow-Bar">0 6 20 0 #33000000</BoxShadows>
  <BoxShadows x:Key="Share-Shadow-Focus">0 0 0 2 #0EB39E</BoxShadows>
</ResourceDictionary>
