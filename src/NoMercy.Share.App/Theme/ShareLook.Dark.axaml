<!-- NoMercy Share's look on top of the NM tokens (dark): the bar, its ring, one soft shadow and the focus ring. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Share-Bar-Brush" Color="#161616" />
  <SolidColorBrush x:Key="Share-Ring-Brush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Share-Hover-Brush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="Share-Separator-Brush" Color="#2EFFFFFF" />
  <BoxShadows x:Key="Share-Shadow-Bar">0 6 20 0 #66000000</BoxShadows>
  <BoxShadows x:Key="Share-Shadow-Focus">0 0 0 2 #0BD8B6</BoxShadows>
</ResourceDictionary>
