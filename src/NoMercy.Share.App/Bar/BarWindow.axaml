<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NoMercy.Share.App" xmlns:icons="using:NoMercy.Share.App.Icons"
        xmlns:bar="using:NoMercy.Share.Core.Bar" xmlns:capture="using:NoMercy.Share.Core.Capture"
        x:Class="NoMercy.Share.App.BarWindow" x:DataType="bar:BarViewModel"
        Title="{local:Loc app.name}" WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" CanResize="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
  <StackPanel Margin="{DynamicResource Nm-Space-6-Thickness}">
    <Border x:Name="Pill" Background="{DynamicResource Share-Bar-Brush}" BorderBrush="{DynamicResource Share-Ring-Brush}" BorderThickness="1"
            CornerRadius="{DynamicResource Nm-Radius-Full-Corner}" BoxShadow="{DynamicResource Share-Shadow-Bar}"
            Padding="{DynamicResource Nm-Space-1-Thickness}" HorizontalAlignment="Left"
            AutomationProperties.Name="{local:Loc bar.automation}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-0-5}">
        <Border x:Name="Handle" Classes="brand" Background="Transparent" Cursor="SizeAll" Padding="{DynamicResource Nm-Space-2-Thickness}"
                ToolTip.Tip="{local:Loc bar.drag}" AutomationProperties.Name="{local:Loc bar.drag}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}" VerticalAlignment="Center">
            <local:NoMercyMark Width="20" Height="20" />
            <icons:MoooomIcon Kind="grabDots" />
          </StackPanel>
        </Border>
        <Border Classes="separator" />
        <Button x:Name="ScreenshotButton" Classes="bar" Classes.active="{Binding Row.IsScreenshotMode}" Command="{Binding ActionCommand}"
                CommandParameter="{x:Static bar:BarAction.Screenshot}" ToolTip.Tip="{local:Loc bar.screenshot}" AutomationProperties.Name="{local:Loc bar.screenshot}"
                AutomationProperties.HelpText="{Binding Row.ScreenshotState}">
          <icons:MoooomIcon Kind="camera" />
        </Button>
        <Button x:Name="RecordButton" Classes="bar" Classes.active="{Binding Row.IsRecordHighlighted}" Classes.recording="{Binding IsRecording}" Command="{Binding ActionCommand}"
                CommandParameter="{x:Static bar:BarAction.Record}" ToolTip.Tip="{Binding RecordLabel}" AutomationProperties.Name="{Binding RecordLabel}"
                AutomationProperties.HelpText="{Binding Row.RecordState}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-2}" VerticalAlignment="Center">
            <icons:MoooomIcon Kind="webcam" />
            <Ellipse Classes="recording-dot" IsVisible="{Binding IsRecording}" />
            <TextBlock Classes="recording-time" IsVisible="{Binding IsRecording}" Text="{Binding ElapsedText}" />
          </StackPanel>
        </Button>
        <Button x:Name="WebButton" Classes="bar" Classes.active="{Binding Row.IsWebMode}" Command="{Binding ActionCommand}"
                CommandParameter="{x:Static bar:BarAction.WebPage}" ToolTip.Tip="{local:Loc bar.webpage}" AutomationProperties.Name="{local:Loc bar.webpage}"
                AutomationProperties.HelpText="{Binding Row.WebState}">
          <icons:MoooomIcon Kind="globe" />
        </Button>
        <Border Classes="separator" />
        <StackPanel Classes="group" IsVisible="{Binding Row.ShowsTargets}">
          <Button Classes="bar" Classes.active="{Binding Row.IsAreaPicked}" Command="{Binding PickTargetCommand}" CommandParameter="{x:Static capture:CaptureKind.Region}"
                  ToolTip.Tip="{local:Loc row.area}" AutomationProperties.Name="{local:Loc row.area}" AutomationProperties.HelpText="{Binding Row.AreaState}">
            <icons:MoooomIcon Kind="crossHair" />
          </Button>
          <Button Classes="bar" Classes.active="{Binding Row.IsWindowPicked}" Command="{Binding PickTargetCommand}" CommandParameter="{x:Static capture:CaptureKind.Window}"
                  ToolTip.Tip="{local:Loc row.window}" AutomationProperties.Name="{local:Loc row.window}" AutomationProperties.HelpText="{Binding Row.WindowState}">
            <icons:MoooomIcon Kind="macOsWindow" />
          </Button>
          <Button Classes="bar" Classes.active="{Binding Row.IsFullScreenPicked}" Command="{Binding PickTargetCommand}" CommandParameter="{x:Static capture:CaptureKind.FullScreen}"
                  ToolTip.Tip="{local:Loc row.fullscreen}" AutomationProperties.Name="{local:Loc row.fullscreen}" AutomationProperties.HelpText="{Binding Row.FullScreenState}">
            <icons:MoooomIcon Kind="monitor" />
          </Button>
          <Border Classes="separator" />
        </StackPanel>
        <!-- The open web panel's mode sits where the targets sit; a click only picks it. -->
        <StackPanel Classes="group" IsVisible="{Binding WebPanel, Converter={x:Static ObjectConverters.IsNotNull}}" IsEnabled="{Binding !WebPanel.IsBusy}">
          <Button Classes="bar" Classes.active="{Binding WebPanel.IsFullPageMode}" Command="{Binding WebPanel.PickModeCommand}" CommandParameter="{x:Static capture:WebCaptureKind.FullPage}"
                  ToolTip.Tip="{local:Loc web.mode.full}" AutomationProperties.Name="{local:Loc web.mode.full}" AutomationProperties.HelpText="{Binding WebPanel.FullPageState}">
            <icons:MoooomIcon Kind="fileLines" />
          </Button>
          <Button Classes="bar" Classes.active="{Binding WebPanel.IsViewportMode}" Command="{Binding WebPanel.PickModeCommand}" CommandParameter="{x:Static capture:WebCaptureKind.Viewport}"
                  ToolTip.Tip="{local:Loc web.mode.viewport}" AutomationProperties.Name="{local:Loc web.mode.viewport}" AutomationProperties.HelpText="{Binding WebPanel.ViewportState}">
            <icons:MoooomIcon Kind="macOsWindow" />
          </Button>
          <Button Classes="bar" Classes.active="{Binding WebPanel.IsElementMode}" Command="{Binding WebPanel.PickModeCommand}" CommandParameter="{x:Static capture:WebCaptureKind.Element}"
                  ToolTip.Tip="{local:Loc web.mode.element}" AutomationProperties.Name="{local:Loc web.mode.element}" AutomationProperties.HelpText="{Binding WebPanel.ElementState}">
            <icons:MoooomIcon Kind="crossHair" />
          </Button>
          <Border Classes="separator" />
        </StackPanel>
        <StackPanel Classes="group" IsVisible="{Binding Row.ShowsRecordControls}">
          <Button Classes="bar" Classes.active="{Binding IsMicrophoneOn}" Command="{Binding ToggleMicrophoneCommand}"
                  ToolTip.Tip="{Binding MicrophoneTip}" AutomationProperties.Name="{local:Loc row.microphone}" AutomationProperties.HelpText="{Binding MicrophoneState}">
            <Panel>
              <icons:MoooomIcon Kind="mic" IsVisible="{Binding IsMicrophoneOn}" />
              <icons:MoooomIcon Kind="micMuted" IsVisible="{Binding !IsMicrophoneOn}" />
            </Panel>
          </Button>
          <Button Classes="bar" Classes.active="{Binding IsDesktopAudioOn}" Command="{Binding ToggleDesktopAudioCommand}"
                  ToolTip.Tip="{Binding DesktopAudioTip}" AutomationProperties.Name="{local:Loc row.desktopaudio}" AutomationProperties.HelpText="{Binding DesktopAudioState}">
            <Panel>
              <icons:MoooomIcon Kind="volumeThree" IsVisible="{Binding IsDesktopAudioOn}" />
              <icons:MoooomIcon Kind="volumeMuted" IsVisible="{Binding !IsDesktopAudioOn}" />
            </Panel>
          </Button>
          <Button x:Name="StartButton" Classes="bar ask first" Command="{Binding StartRecordingCommand}" Content="{local:Loc row.start}"
                  ToolTip.Tip="{local:Loc row.start}" AutomationProperties.Name="{local:Loc row.start}" />
          <Border Classes="separator" />
        </StackPanel>
        <Button Classes="bar" Command="{Binding ActionCommand}" CommandParameter="{x:Static bar:BarAction.Recent}" ToolTip.Tip="{local:Loc bar.recent}" AutomationProperties.Name="{local:Loc bar.recent}">
          <icons:MoooomIcon Kind="link" />
        </Button>
        <Button Classes="bar" Command="{Binding ActionCommand}" CommandParameter="{x:Static bar:BarAction.Settings}" ToolTip.Tip="{local:Loc bar.settings}" AutomationProperties.Name="{local:Loc bar.settings}">
          <icons:MoooomIcon Kind="settings" />
        </Button>
        <Border Classes="separator" />
        <Button Classes="bar" Command="{Binding ActionCommand}" CommandParameter="{x:Static bar:BarAction.Close}" ToolTip.Tip="{local:Loc bar.close}" AutomationProperties.Name="{local:Loc bar.close}">
          <icons:MoooomIcon Kind="cross" />
        </Button>
      </StackPanel>
    </Border>
    <!-- Under the bar, its left edge in line with the bar's; the panel has its own 24-unit shadow margin, so the offsets undo it. -->
    <Popup x:Name="RecentPopup" IsOpen="{Binding IsRecentOpen, Mode=TwoWay}" PlacementTarget="{Binding #Pill}" Placement="BottomEdgeAlignedLeft"
           HorizontalOffset="-24" VerticalOffset="-16" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #Pill}">
      <local:RecentPanel />
    </Popup>
    <ContentControl Content="{Binding WebPanel}" IsVisible="{Binding WebPanel, Converter={x:Static ObjectConverters.IsNotNull}}"
                    HorizontalAlignment="Left" Margin="0,8,0,0">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="capture:WebCaptureViewModel">
          <local:WebCapturePanel />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <Border Background="{DynamicResource Share-Bar-Brush}" BorderBrush="{DynamicResource Share-Ring-Brush}" BorderThickness="1"
            CornerRadius="{DynamicResource Nm-Radius-Full-Corner}" Padding="{DynamicResource Nm-Space-3-Thickness}"
            BoxShadow="{DynamicResource Share-Shadow-Bar}" Margin="{DynamicResource Nm-Space-2-Thickness}" HorizontalAlignment="Left"
            IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Nm-Text-Secondary-Brush}" FontSize="{DynamicResource Nm-Font-Size-Sm}"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
    <!-- What to do with the capture; nothing is uploaded until Copy link. -->
    <Border x:Name="ChoicePanel" Background="{DynamicResource Share-Bar-Brush}" BorderBrush="{DynamicResource Share-Ring-Brush}" BorderThickness="1"
            CornerRadius="{DynamicResource Nm-Radius-Full-Corner}" Padding="{DynamicResource Nm-Space-3-Thickness}"
            BoxShadow="{DynamicResource Share-Shadow-Bar}" Margin="{DynamicResource Nm-Space-2-Thickness}" HorizontalAlignment="Left"
            IsVisible="{Binding Choice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
        <TextBlock Text="{Binding Choice.Text, FallbackValue={x:Null}}" Foreground="{DynamicResource Nm-Text-Secondary-Brush}" FontSize="{DynamicResource Nm-Font-Size-Sm}"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        <Button x:Name="CopyImageButton" Classes="bar ask first" Command="{Binding CopyImageCommand}" Content="{local:Loc choice.copyimage}"
                IsVisible="{Binding Choice.CanCopyImage, FallbackValue=False}" />
        <Button x:Name="CopyLinkButton" Classes="bar ask" Command="{Binding ShareLinkCommand}" Content="{local:Loc choice.copylink}" />
        <Button Classes="bar ask" Command="{Binding DismissChoiceCommand}" Content="{local:Loc choice.done}" />
      </StackPanel>
    </Border>
    <!-- Stays until it is answered; the notice timer never clears it. -->
    <Border x:Name="AccessAsk" Background="{DynamicResource Share-Bar-Brush}" BorderBrush="{DynamicResource Share-Ring-Brush}" BorderThickness="1"
            CornerRadius="{DynamicResource Nm-Radius-Full-Corner}" Padding="{DynamicResource Nm-Space-3-Thickness}"
            BoxShadow="{DynamicResource Share-Shadow-Bar}" Margin="{DynamicResource Nm-Space-2-Thickness}" HorizontalAlignment="Left"
            IsVisible="{Binding Ask, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm-Space-3}">
        <TextBlock Text="{Binding Ask.Text, FallbackValue={x:Null}}" Foreground="{DynamicResource Nm-Text-Secondary-Brush}" FontSize="{DynamicResource Nm-Font-Size-Sm}"
                   VerticalAlignment="Center" MaxWidth="360" Margin="{DynamicResource Nm-Space-2-Thickness}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        <Button x:Name="AllowButton" Classes="bar ask first" Command="{Binding AskYesCommand}" Content="{Binding Ask.YesLabel, FallbackValue={x:Null}}" />
        <Button Classes="bar ask" Command="{Binding AskNoCommand}" Content="{Binding Ask.NoLabel, FallbackValue={x:Null}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
