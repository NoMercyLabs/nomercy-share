<!-- The look of the floating bar: round icon buttons, hover tint, a focus ring on the button edge (an outer ring is clipped by the button's square bounds), accent only on focus and while active. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:NoMercy.Share.App.Icons">
  <Style Selector="Button.bar">
    <Setter Property="Width" Value="{DynamicResource Nm-Space-9}" />
    <Setter Property="Height" Value="{DynamicResource Nm-Space-9}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm-Radius-Full-Corner}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.bar icons|MoooomIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{DynamicResource Nm-Text-Secondary-Brush}" />
  </Style>
  <Style Selector="Button.bar:pointerover icons|MoooomIcon, Button.bar:focus-visible icons|MoooomIcon">
    <Setter Property="Stroke" Value="{DynamicResource Nm-Text-Primary-Brush}" />
  </Style>
  <!-- While recording the button grows to fit the red dot and the mm:ss timer; its shape stays the bar's pill. -->
  <Style Selector="Button.bar.recording">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Padding" Value="{DynamicResource Nm-Space-2-Thickness}" />
  </Style>
  <Style Selector="Ellipse.recording-dot">
    <Setter Property="Width" Value="{DynamicResource Nm-Space-2}" />
    <Setter Property="Height" Value="{DynamicResource Nm-Space-2}" />
    <Setter Property="Fill" Value="{DynamicResource Nm-Red-10-Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.recording-time">
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Primary-Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Sm}" />
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.bar.active icons|MoooomIcon">
    <Setter Property="Stroke" Value="{DynamicResource Nm-Accent-Brush}" />
  </Style>
  <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Share-Hover-Brush}" />
  </Style>
  <!-- A row answer always holds the ring's 2 px, so focus never widens it and moves the text beside it. -->
  <Style Selector="Button.bar.answer /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- The ring is a 2 px border in the accent token, so each theme's own accent step sets its contrast. -->
  <Style Selector="Button.bar:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm-Accent-Brush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Share-Pressed-Brush}" />
  </Style>
  <Style Selector="Button.bar:pressed">
    <Setter Property="RenderTransform" Value="translateY(1px)" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource Share-Separator-Brush}" />
  </Style>
  <!-- A group of the row that comes and goes with the mode, spaced like the row itself. -->
  <Style Selector="StackPanel.group">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource Nm-Space-0-5}" />
  </Style>
  <!-- The recent links list: a rounded card under the bar; rows tint on hover and selection like the bar buttons. -->
  <!-- A text button of the access ask: the bar button's size, hover and focus ring, as wide as its label. -->
  <Style Selector="Button.bar.ask">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MinWidth" Value="{DynamicResource Nm-Space-9}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Secondary-Brush}" />
  </Style>
  <Style Selector="Button.bar.ask.first">
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Primary-Brush}" />
  </Style>
  <!-- The answers inside a recent row are tighter, so the question beside them stays whole. -->
  <Style Selector="Button.bar.ask.answer">
    <Setter Property="Padding" Value="{DynamicResource Nm-Space-2-Thickness}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Xs}" />
  </Style>
  <Style Selector="Button.bar.small">
    <Setter Property="Width" Value="{DynamicResource Nm-Space-7}" />
    <Setter Property="Height" Value="{DynamicResource Nm-Space-7}" />
  </Style>
  <Style Selector="Button.bar.small icons|MoooomIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="ListBox.recent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxHeight" Value="312" />
  </Style>
  <Style Selector="ListBox.recent > ListBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Nm-Space-1-5-Thickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm-Radius-Xl-Corner}" />
  </Style>
  <!-- The row always holds its focus ring's 2 px inside its 8 px inset, so a focused row stays the same size. -->
  <Style Selector="ListBox.recent > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBox.recent > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.recent > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Share-Hover-Brush}" />
  </Style>
  <!-- :focus, not :focus-within: while a button inside the row has the keyboard, only that button shows a ring. -->
  <Style Selector="ListBox.recent > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm-Accent-Brush}" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Width" Value="{DynamicResource Nm-Space-10}" />
    <Setter Property="Height" Value="{DynamicResource Nm-Space-10}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm-Radius-Lg-Corner}" />
    <Setter Property="Background" Value="{DynamicResource Share-Hover-Brush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.thumb icons|MoooomIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource Nm-Text-Secondary-Brush}" />
  </Style>
  <Style Selector="TextBlock.row-path, TextBlock.row-question">
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Primary-Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Sm}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.row-detail">
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Secondary-Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Xs}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Grid.recent-row.expired Border.thumb, Grid.recent-row.expired TextBlock.row-path">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBlock.recent-empty">
    <Setter Property="Foreground" Value="{DynamicResource Nm-Text-Secondary-Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm-Font-Size-Sm}" />
    <Setter Property="Margin" Value="{DynamicResource Nm-Space-4-Thickness}" />
  </Style>
  <Style Selector="Border.brand icons|MoooomIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{DynamicResource Nm-Text-Muted-Brush}" />
  </Style>
</Styles>
